# ============================================================
# SatQuery AI — Environment Configuration
# ============================================================

# ── Frontend (Vite) ──────────────────────────────────────────
# All API calls route through the Spring Boot Gateway on 8080
VITE_MOCK_MODE=false
VITE_API_BASE_URL=http://localhost:8080

# ── Python Backend ───────────────────────────────────────────
# FastAPI backend runs on port 8000 (Gateway on 8080)
PORT=8000
HOST=0.0.0.0

# ── Storage — MinIO ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=satquery_minio
MINIO_SECRET_KEY=satquery_minio_secret
MINIO_SECURE=false

# ── Storage — MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://satquery:satquery_secret@localhost:27017/satquery_db?authSource=admin

# ── Storage — Redis ───────────────────────────────────────────
REDIS_URL=redis://:satquery_redis_secret@localhost:6379/0
REDIS_RESULT_TTL_S=3600

# ── Cloud GPU Dispatcher ──────────────────────────────────────
# Leave empty to use mock responses (default — works without GPU).
# Set to your Colab/Kaggle ngrok tunnel URL to enable real inference:
#   CLOUD_GPU_ENDPOINT=https://xxxx.ngrok.io
CLOUD_GPU_ENDPOINT=
CLOUD_GPU_TIMEOUT_S=120

# ── Model Paths (optional overrides) ─────────────────────────
# OPTICAL_CHANGE_MODEL_PATH=
# OPTICAL_SAR_MODEL_PATH=
# VLM_MODEL_BUNDLE_PATH=
# FORCE_CPU=false
