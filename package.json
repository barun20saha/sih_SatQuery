{
  "name": "satquery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node dev-runner.js",
    "dev:frontend": "vite",
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
